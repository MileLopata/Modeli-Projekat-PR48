<Page x:Class="NMSTestClientGUI.Pages.GetRelatedValuesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:NMSTestClientGUI.Pages"
      mc:Ignorable="d"
      Background="White"
      Title="GetRelatedValuesPage">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Panel -->
        <StackPanel Grid.Column="0" Margin="15" VerticalAlignment="Stretch">
            <TextBlock Text="Get Related Values" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Margin="0,0,0,10">
                <Label Content="Choose GID:" FontWeight="Bold"/>
                <ComboBox x:Name="GIDComboBox" Height="32" SelectionChanged="GIDComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,10">
                <Label Content="Choose Association ModelCode:" FontWeight="Bold"/>
                <ComboBox x:Name="AssociationComboBox" Height="32" SelectionChanged="AssociationComboBox_SelectionChanged"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,20">
                <Label Content="Choose concrete class DMSType:" FontWeight="Bold"/>
                <ComboBox x:Name="DMSTypeComboBox" Height="32" SelectionChanged="DMSTypeComboBox_SelectionChanged"/>
            </StackPanel>

            <Button x:Name="GetRelatedValuesButton" Content="Get Related Values"
                    Height="34" Background="DodgerBlue" Foreground="White"
                    Click="GetRelatedValuesButton_Click" Visibility="Hidden"
                    HorizontalAlignment="Left" Margin="0,0,0,10"/>

            <CheckBox x:Name="SelectAllCheckBox" Content="Select All Properties"
                      FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"
                      Click="SelectAllCheckBox_Click" Visibility="Hidden"/>

            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="5" Background="#F8F8F8">
                <ScrollViewer Height="400" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CheckBoxGrid" Margin="10,0">
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Margin" Value="0,6,0,6"/>
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </StackPanel>

        <!-- Results Panel -->
        <StackPanel Grid.Column="1" Margin="15">
            <TextBlock Text="Results:" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="5">
                <TextBox x:Name="ResultsTextBox"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="600"
                         FontFamily="Consolas"
                         FontSize="14"
                         Background="#FAFAFA"/>
            </Border>
        </StackPanel>
    </Grid>
</Page>
