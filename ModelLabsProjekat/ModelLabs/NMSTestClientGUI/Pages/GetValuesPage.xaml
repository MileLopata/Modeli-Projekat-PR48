<Page x:Class="NMSTestClientGUI.Pages.GetValuesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Background="#F4F7FA"
      Title="GetValuesPage">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left panel -->
        <Border Grid.Column="0" Background="White" CornerRadius="10" Padding="20" Margin="0,0,20,0" 
                BorderBrush="#D1DCE3" BorderThickness="1" >
            <StackPanel VerticalAlignment="Top" >

                <TextBlock Text="Choose GID:" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                <ComboBox x:Name="GIDCombobox" Height="35" Margin="0,0,0,15"
                          FontSize="14" Padding="5"
                          Background="#ECF0F1" BorderBrush="#BDC3C7"
                          SelectionChanged="GIDCombobox_SelectionChanged"/>

                <Button x:Name="GetValuesButton" Content="Get Values" Height="35" Width="150"
                        Background="#3498DB" Foreground="White" FontWeight="Bold"
                        BorderThickness="0" Cursor="Hand"
                        Margin="0,0,0,20" Click="GetValuesButton_Click" />

                <CheckBox x:Name="SelectAllCheckBox" Content="Select All Properties"
                          FontSize="14" FontWeight="Medium"
                          Margin="0,0,0,10" Click="SelectAllCheckBox_Click" Visibility="Hidden"/>

                <TextBlock Text="Available Properties:" FontSize="14" FontWeight="SemiBold" Margin="0,10,0,10"/>
                <ScrollViewer Height="500" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="CheckBoxGrid">
                        <StackPanel.Resources>
                            <Style TargetType="CheckBox">
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="Margin" Value="0,8,0,8"/>
                            </Style>
                        </StackPanel.Resources>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- Right panel -->
        <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20"
                BorderBrush="#D1DCE3" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Results" FontSize="16" FontWeight="SemiBold" Foreground="#2C3E50" Margin="0,0,0,10"/>
                <TextBox x:Name="ResultsTextBox"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="600"
                         FontFamily="Consolas"
                         FontSize="14"
                         Background="#ECF0F1"
                         Padding="10"
                         BorderThickness="0"
                         Foreground="#2C3E50"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
