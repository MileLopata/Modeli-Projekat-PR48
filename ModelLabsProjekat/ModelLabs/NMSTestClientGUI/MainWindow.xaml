<Window x:Class="NMSTestClientGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NMSTestClientGUI"
        xmlns:pages="clr-namespace:NMSTestClientGUI.Pages"
        mc:Ignorable="d"
        Title="NMS Test Client" Height="800" Width="1000"
        Background="White">

    <Grid Margin="10">
        <TabControl Background="White" FontSize="14" FontWeight="SemiBold" Padding="10"
                    BorderThickness="1" BorderBrush="LightGray">
            <TabItem Header="Get Values" Padding="10,5">
                <Frame Source="Pages/GetValuesPage.xaml"
                       NavigationUIVisibility="Hidden"
                       Margin="0"/>
            </TabItem>
            <TabItem Header="Get Extent Values" Padding="10,5">
                <Frame Source="Pages/GetExtentValuesPage.xaml"
                       NavigationUIVisibility="Hidden"
                       Margin="0"/>
            </TabItem>
            <TabItem Header="Get Related Values" Padding="10,5">
                <Frame Source="Pages/GetRelatedValuesPage.xaml"
                       NavigationUIVisibility="Hidden"
                       Margin="0"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
